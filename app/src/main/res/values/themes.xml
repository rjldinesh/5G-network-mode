<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- System splash screen (white background + launcher icon) -->
    <style name="Theme.FiveGNetworkMode.Starting" parent="Theme.SplashScreen">
        <!-- Splash screen background color -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- App icon in center -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Compose theme to apply after splash -->
        <item name="postSplashScreenTheme">@style/Theme.FiveGNetworkMode</item>
    </style>

    <!-- Base app theme (just bridge to Compose).
         Status/navigation bar color and icon appearance are intentionally NOT set here:
         MainActivity calls enableEdgeToEdge() and _4GNetworkModeTheme (Theme.kt) drives
         transparent system bars + icon contrast in code. Setting android:statusBarColor /
         android:navigationBarColor / android:windowLightStatusBar / android:windowLightNavigationBar
         here paints opaque bars on API < 35 (defeating edge-to-edge for those users) while
         being ignored on API 35+, which is exactly what caused edge-to-edge to not display
         for all users. -->
    <style name="Theme.FiveGNetworkMode" parent="android:Theme.Light.NoTitleBar" />

</resources>