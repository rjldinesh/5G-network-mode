<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- System splash screen (white background + launcher icon) -->
    <style name="Theme.FiveGNetworkMode.Starting" parent="Theme.SplashScreen">
        <!-- Splash screen background color -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- App icon in center -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Compose theme to apply after splash -->
        <item name="postSplashScreenTheme">@style/Theme.FiveGNetworkMode</item>
    </style>

    <!-- Base app theme (just bridge to Compose) -->
    <style name="Theme.FiveGNetworkMode" parent="android:Theme.Light.NoTitleBar">
        <item name="android:statusBarColor">#0070FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="o_mr1">true</item>    </style>

</resources>